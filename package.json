{
  "name": "composition",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run build:lib && npm run build:site",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:site": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
